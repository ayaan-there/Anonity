# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Contract compiler output — ignore everything by default, but track the
# counter compiled artifacts (keys, zkir, contract JS, compiler JSON) so
# reviewers can verify successful compilation. Pattern: ignore children
# of managed/ but re-include counter/ and everything under it.
contracts/managed/*
!contracts/managed/counter/
contracts/managed/counter/*
!contracts/managed/counter/keys/
!contracts/managed/counter/zkir/
!contracts/managed/counter/contract/
!contracts/managed/counter/compiler/

# Anonity compiled artifacts (L4) — same whitelist pattern as counter
!contracts/managed/anonity/
contracts/managed/anonity/*
!contracts/managed/anonity/keys/
!contracts/managed/anonity/zkir/
!contracts/managed/anonity/contract/
!contracts/managed/anonity/compiler/

# Transparent demo compiled artifacts — required by the Vercel build when
# VITE_PAYMENT_MODE=unshielded-demo.
!contracts/managed/anonity-demo-unshielded/
contracts/managed/anonity-demo-unshielded/*
!contracts/managed/anonity-demo-unshielded/keys/
!contracts/managed/anonity-demo-unshielded/zkir/
!contracts/managed/anonity-demo-unshielded/contract/
!contracts/managed/anonity-demo-unshielded/compiler/

# Deployment info
deployment.json

# Wallet seed (sensitive)

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state
*-state/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses)
.midnight-state.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/

# Midnight local private state store (LevelDB from counter deploy)
midnight-level-db/

# Frontend build artifacts (copied from contracts/managed/counter/ during build)
public/keys/
public/zkir/
public/demo/

# Vercel CLI
.vercel/

# Supabase CLI temporary project metadata
supabase/.temp/

# Environment overrides
.env.preprod
.env.preprod.local
.env.*.local

# Local context files (never tracked)
AGENTS.md
PRD.md
local-test-identities/

# Helper shell scripts (dev-only, not for submission)
*.sh

# Local Stitch design reference files
design-reference/

# Local tooling
.skills/
.agents/
skills-lock.json

.vercel
