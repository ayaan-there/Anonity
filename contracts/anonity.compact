pragma language_version >= 0.23;

import CompactStandardLibrary;

// ═══════════════════════════════════════════════════════════════════
// Anonity (VeilWork) — privacy-preserving anonymous bug bounty core.
//
// PUBLIC (on-chain, visible to anyone via the indexer):
//   - bounties: amount, deadline, org commitment, open/closed status
//   - submissions: bounty link, hunter commitment, resolution outcome
//   - aggregate fee accounting: escrowed / forfeited / refunded / paid
//
// PRIVATE (witnesses, never on-chain, never in any proof):
//   - orgSecretKey(): the organization's 32-byte identity secret
//   - hunterSecretKey(): the researcher's 32-byte identity secret
//   Report CONTENTS are never stored on-chain at all.
//
// PROVED WITHOUT REVEALING:
//   - That the caller resolving a submission is the exact org that
//     posted the bounty (commitment match inside the proof).
//   - That each hunter identity is a stable commitment derived from a
//     secret only they hold — the chain sees a hash, never the key,
//     never a wallet address, and cannot link commitments across
//     bounties or after a round rotation.
//
// The anti-spam deposit is received as a shielded coin. The contract never
// receives a transparent payment tied to the submitter's address.
// ═══════════════════════════════════════════════════════════════════

enum BountyStatus { Open, Closed };
enum Outcome { Pending, Valid, Duplicate, Slop };

struct Bounty {
    amount: Uint<64>,
    deadline: Uint<64>,
    org: Bytes<32>,
    status: BountyStatus,
}

struct Submission {
    bountyId: Uint<64>,
    hunter: Bytes<32>,
    outcome: Outcome,
    payoutAmount: Uint<64>,
}

export ledger bounties: Map<Uint<64>, Bounty>;
export ledger submissions: Map<Uint<64>, Submission>;
export ledger claimed: Map<Uint<64>, Boolean>;

// Monotonic id allocation (starts at 1)
export ledger nextBountyId: Counter;
export ledger nextSubmissionId: Counter;

// Global epoch — bumping it rotates every commitment, unlinking identities
export ledger round: Counter;

// Fee accounting (anti-spam deposit is fixed at 5 NIGHT for the MVP).
// `feesBurned` is retained as a compatibility field and means forfeited.
export ledger feeEscrowed: Uint<64>;
export ledger feesBurned: Uint<64>;
export ledger feesRefunded: Uint<64>;
export ledger totalPaid: Uint<64>;

constructor() {
    round.increment(1);
    nextBountyId.increment(1);
    nextSubmissionId.increment(1);
}

// ─── Private witnesses ──────────────────────────────────────────────

witness orgSecretKey(): Bytes<32>;
witness hunterSecretKey(): Bytes<32>;

// ─── Identity commitments (same pattern as counter.owner) ──────────

export circuit orgKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>(
        [pad(32, "veilwork:org:"), round as Bytes<32>, sk]);
}

export circuit hunterKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>(
        [pad(32, "veilwork:hunter:"), round as Bytes<32>, sk]);
}

// ─── Org flow ───────────────────────────────────────────────────────

// Post a bounty. Only proof of holding an org secret is required — any
// org can participate without registering or revealing an address.
export circuit postBounty(amount: Uint<64>, deadline: Uint<64>): Uint<64> {
    assert(amount > 0, "postBounty: amount must be positive");
    const id = nextBountyId;
    const sk = orgSecretKey();
    const org = orgKey(sk);
    bounties.insert(
        disclose(id),
        disclose(Bounty {
            amount: disclose(amount),
            deadline: disclose(deadline),
            org: disclose(org),
            status: BountyStatus.Open,
        }),
    );
    nextBountyId.increment(1);
    return id;
}

// Edit an open bounty's amount/deadline. Caller proves they hold the
// posting org's secret — no on-chain identity ever changes hands.
export circuit updateBounty(rawId: Uint<64>, rawAmount: Uint<64>, rawDeadline: Uint<64>): [] {
    const id = disclose(rawId);
    const amount = disclose(rawAmount);
    const deadline = disclose(rawDeadline);
    assert(amount > 0, "updateBounty: amount must be positive");
    assert(bounties.member(id), "updateBounty: no such bounty");
    const b = bounties.lookup(id);
    assert(b.status == BountyStatus.Open, "updateBounty: bounty is not open");
    const sk = orgSecretKey();
    assert(b.org == orgKey(sk), "updateBounty: caller is not the bounty org");
    bounties.remove(id);
    bounties.insert(
        disclose(id),
        disclose(Bounty {
            amount,
            deadline,
            org: b.org,
            status: BountyStatus.Open,
        }),
    );
}

// ─── Hunter flow ────────────────────────────────────────────────────

// Submit a report anonymously. The chain learns THAT a qualified
// submission exists for a bounty — never WHO submitted it. A fixed
// anti-spam fee moves into escrow; the outcome records refund or forfeit.
export circuit submitReport(rawBountyId: Uint<64>, feeCoin: ShieldedCoinInfo): Uint<64> {
    const bountyId = disclose(rawBountyId);
    assert(bounties.member(bountyId), "submitReport: no such bounty");
    const b = bounties.lookup(bountyId);
    assert(b.status == BountyStatus.Open, "submitReport: bounty is not open");
    // 5 NIGHT = 5,000,000 atomic units on Preprod. The wallet must create
    // this output for the contract in the same transaction.
    assert(feeCoin.color == nativeToken(), "submitReport: fee must be NIGHT");
    assert(feeCoin.value == 5000000 as Uint<128>, "submitReport: fee must be 5 NIGHT");
    receiveShielded(disclose(feeCoin));
    const sk = hunterSecretKey();
    const hunter = hunterKey(sk);
    const sid = nextSubmissionId;
    submissions.insert(
        disclose(sid),
        disclose(Submission {
            bountyId,
            hunter: disclose(hunter),
            outcome: Outcome.Pending,
            payoutAmount: 0 as Uint<64>,
        }),
    );
    feeEscrowed = disclose((feeEscrowed + 5) as Uint<64>);
    nextSubmissionId.increment(1);
    return sid;
}

// ─── Resolution (org-only, proven inside ZK) ────────────────────────

// Resolve a submission. Caller must hold the org secret that produced
// the bounty's commitment — checked inside the proof. Outcomes:
//   1 = Valid      → bounty marked paid, fee refund recorded
//   2 = Duplicate  → fee refund recorded
//   3 = Slop       → fee forfeiture recorded
export circuit resolveSubmission(rawSubmissionId: Uint<64>, rawOutcome: Uint<8>, payoutCoin: ShieldedCoinInfo): [] {
    const submissionId = disclose(rawSubmissionId);
    const outcome = disclose(rawOutcome);
    assert(submissions.member(submissionId), "resolve: no such submission");
    const sub = submissions.lookup(submissionId);
    assert(sub.outcome == Outcome.Pending, "resolve: already resolved");
    const bid = sub.bountyId;
    assert(bounties.member(bid), "resolve: bounty missing");
    const sk = orgSecretKey();
    assert(bounties.lookup(bid).org == orgKey(sk), "resolve: caller is not the bounty org");
    assert(outcome >= 1 && outcome <= 3, "resolve: invalid outcome");

    if (outcome == 2 as Uint<8>) {
        // duplicate → refund is recorded; funds remain escrowed until a
        // shielded recipient transfer path is available.
        feesRefunded = disclose((feesRefunded + 5) as Uint<64>);
    } else { if (outcome == 3 as Uint<8>) {
        // slop → fee is forfeited to the contract treasury. Compact has no
        // native burn primitive in this deployment model.
        feesBurned = disclose((feesBurned + 5) as Uint<64>);
    } else {
        // valid → refund and bounty payout are recorded. The payout/refund
        // coin is received shielded and can only be claimed by the hunter.
        assert(payoutCoin.color == nativeToken(), "resolve: payout must be NIGHT");
        assert(payoutCoin.value > 0, "resolve: valid payout must be positive");
        receiveShielded(disclose(payoutCoin));
        feesRefunded = disclose((feesRefunded + 5) as Uint<64>);
        totalPaid = disclose((totalPaid + (payoutCoin.value as Uint<64>)) as Uint<64>);
        const b = bounties.lookup(bid);
        bounties.remove(bid);
        bounties.insert(
            disclose(bid),
            disclose(Bounty {
                amount: b.amount,
                deadline: b.deadline,
                org: b.org,
                status: BountyStatus.Closed,
            }),
        );
    } }

    submissions.remove(submissionId);
    const resolved: Outcome =
        outcome == 1 as Uint<8> ? Outcome.Valid :
        outcome == 2 as Uint<8> ? Outcome.Duplicate : Outcome.Slop;
    submissions.insert(
        disclose(submissionId),
        disclose(Submission {
            bountyId: bid,
            hunter: sub.hunter,
            outcome: resolved,
            payoutAmount: outcome == 1 as Uint<8> ? payoutCoin.value as Uint<64> : 0 as Uint<64>,
        }),
    );
}

// The caller proves ownership of the hunter commitment. The recipient is
// the caller's shielded wallet key, which may be different from the wallet
// that funded the report fee.
export circuit claimPayout(rawSubmissionId: Uint<64>, payoutCoin: QualifiedShieldedCoinInfo): [] {
    const submissionId = disclose(rawSubmissionId);
    assert(submissions.member(submissionId), "claim: no such submission");
    const sub = submissions.lookup(submissionId);
    assert(sub.outcome == Outcome.Valid, "claim: submission is not payable");
    assert(!claimed.member(submissionId) || !claimed.lookup(submissionId), "claim: payout already claimed");
    const sk = hunterSecretKey();
    assert(sub.hunter == hunterKey(sk), "claim: caller did not submit this report");
    assert(payoutCoin.color == nativeToken(), "claim: payout must be NIGHT");
    assert(payoutCoin.value == sub.payoutAmount, "claim: payout coin amount mismatch");
    sendShielded(
        disclose(payoutCoin),
        left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
        sub.payoutAmount,
    );
    claimed.insert(disclose(submissionId), disclose(true));
}

// ─── Public reads ───────────────────────────────────────────────────

// [amount, deadline, orgCommitment, status(0=open,1=closed)]
export circuit getBounty(rawId: Uint<64>): [Uint<64>, Uint<64>, Bytes<32>, Uint<8>] {
    const id = disclose(rawId);
    const b = bounties.lookup(id);
    return [b.amount, b.deadline, b.org, b.status == BountyStatus.Open ? 0 as Uint<8> : 1 as Uint<8>];
}

// [bountyId, hunterCommitment, outcome(0=pending,1=valid,2=duplicate,3=slop)]
export circuit getSubmission(rawId: Uint<64>): [Uint<64>, Bytes<32>, Uint<8>] {
    const id = disclose(rawId);
    const s = submissions.lookup(id);
    const oc: Uint<8> =
        s.outcome == Outcome.Pending ? 0 as Uint<8> :
        s.outcome == Outcome.Valid ? 1 as Uint<8> :
        s.outcome == Outcome.Duplicate ? 2 as Uint<8> : 3 as Uint<8>;
    return [s.bountyId, s.hunter, oc];
}

// [feeEscrowed, feesBurned (forfeited), feesRefunded, totalPaid]
export circuit getStats(): [Uint<64>, Uint<64>, Uint<64>, Uint<64>] {
    return [feeEscrowed, feesBurned, feesRefunded, totalPaid];
}
